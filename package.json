{
  "name": "privacy-mcp-server",
  "version": "1.0.0",
  "description": "Zero-data-leakage Model Context Protocol (MCP) server for local folder repositories",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:exe": "bun build --compile src/index.ts --outfile privacy-mcp.exe",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.5"
  }
}
